    given-names: Rogerio
    affiliation: University of Wisconsin–Madison (uwplasma)
version: 3.0.0
date-released: "2026-07-18"
license: BSD-2-Clause
repository-code: https://github.com/uwplasma/magpylib_jax
url: https://magpylib-jax.readthedocs.io/
keywords:
  - jax
  - magpylib
  - magnetostatics
  - magnetic field
  - automatic differentiation
  - differentiable physics
references:
